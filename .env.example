# Server-only configuration. Fill in credentials locally or in Railway Variables.
# Chat/embedding model IDs must be selected and verified during foundation setup.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=
OPENROUTER_EMBEDDING_MODEL=
OPENROUTER_DECISION_MODEL=cloudflare/clef

# Zilliz Cloud endpoint and API token. Use a separate collection in production.
ZILLIZ_ENDPOINT=
ZILLIZ_TOKEN=
ZILLIZ_COLLECTION=manufacturing_docs_dev_v1

# Signed browser-workspace cookies. Generate an independent 32+ character secret.
SESSION_SIGNING_SECRET=
APP_ORIGIN=http://localhost:3000

# Optional tracing; disabled until deliberately enabled with fictional data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=manufacturing-docs-demo

# Railway Variables only: RAILPACK_BUN_VERSION=1.4.2 and NODE_ENV=production.
# Railway supplies PORT; the production server must listen on 0.0.0.0.
# Never expose credentials via NEXT_PUBLIC_ variables.

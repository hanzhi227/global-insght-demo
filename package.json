{
  "name": "manufacturing-document-assistant",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "bun --bun node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "setup:vectors": "bun scripts/setup-vectors.ts",
    "seed:corpus": "bun scripts/seed-corpus.ts",
    "check:providers": "bun scripts/check-providers.ts",
    "eval": "bun scripts/evaluate-local.ts",
    "eval:decisions": "bun scripts/evaluate-decisions.ts",
    "eval:live": "bun scripts/evaluate-local.ts --live",
    "eval:api": "bun scripts/evaluate.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
